{
  "name": "saturn-ring-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Physically-scaled real-time simulation of the Saturn system, with a procedural particle-level ring model you can fly into.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "shot": "node scripts/shot.mjs",
    "shots": "node scripts/shots.mjs",
    "img": "node scripts/img.mjs",
    "test": "node scripts/test/run.mjs refs smoke physics counts lod seam exposure edges moonflux particles propellers relief contact sources",
    "check:refs": "node scripts/check-refs.mjs",
    "test:sources": "node scripts/test/sources.mjs",
    "test:smoke": "node scripts/test/smoke.mjs",
    "test:physics": "node scripts/test/physics.mjs",
    "test:counts": "node scripts/test/counts.mjs",
    "test:lod": "node scripts/test/lod.mjs",
    "test:seam": "node scripts/test/seam.mjs",
    "test:fps": "node scripts/test/fps.mjs",
    "test:exposure": "node scripts/test/exposure.mjs",
    "test:edges": "node scripts/test/edges.mjs",
    "test:moonflux": "node scripts/test/moonflux.mjs",
    "test:particles": "node scripts/test/particles.mjs",
    "test:propellers": "node scripts/test/propellers.mjs",
    "test:relief": "node scripts/test/relief.mjs",
    "test:contact": "node scripts/test/contact.mjs",
    "test:wakecost": "node scripts/test/wakecost.mjs",
    "test:framecost": "node scripts/test/framecost.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
