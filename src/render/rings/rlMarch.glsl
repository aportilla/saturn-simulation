// ===== ring layer: near-field ray march through the particle slab ===============================
// Same radiative transfer as the thin sheet (rlOptics), resolved in 3-D: vertical Gaussian layers per
// size class, self-gravity-wake density W(x, y) (clipmap of the shared wakeDensity), sunlight
// attenuated along its own slanted path through the wakes (wake self-shadowing), the two-stream
// multiply-scattered field at the local depth, Saturnshine on both faces, shadow hiding correlated with
// the view path. Only the optical depth NOT drawn as discrete near-field particles (sigUnres) is carried.
// Per step: exact optical depth through the vertical structure (column fraction between the step's end
// heights), sources evaluated at the step ends and integrated with an exponential profile in between
// (rlStepEmit) -- agrees with the analytic sheet to a few % at all elevations, grazing included. The sun path's
// wake density is the mean at the stratified column nodes shared with the particles (sv_ringLod
// ringSunNodeRise); the explicit field's transmission is corrected for the clipmap's density prefilter and the
// statistical wakes' transmission uses the sheet's Gamma path model (rlTransWakesTau), see the end of rlMarch.
//
// Size rules of the LOD contract (sv_ringLod, docs/ring-physics.md 10.12): the medium's particles are split into the
// participating ones (density W, the wake field; thickened by the packing ceiling m(W)) and the others (uniform), the
// spin-aligned classes' cross-section depends on the direction (view: 1 + G(view), single-scattering emission: the
// light intercepted along the Sun, 1 + G(sun); multiple scattering: isotropic). All from the vertical-structure LUT.
//
// The vertical structure comes from a per-frame LUT generated by evaluating the shared sv_ringLod
// function ringLodChannels on a (z/H, log s) grid (3 bands: participating, all, along the Sun), so it is exactly the
// contract the particle renderer uses, at a fraction of the cost (20 transcendentals -> 1 fetch per band).
// Relief (bending waves, corrugation, moonlet edge waves, ...): every height is taken relative to the local
// mid-plane z0 along the ray (evaluated at each step's sample point through sv_ringStructure, extrapolated with its
// slope to the step's ends), the step size follows the rate of change of that relative height, and the sun's side,
// incidence (extended disk) and the shadows cast by the relief are those of the local tilted layer.
// Requires rlOptics + sv_ringLod + sv_wakes.

uniform sampler2D uRlWakeTex;       // W clipmap atlas (R16F), 6 tiles of N x N stacked vertically
uniform vec4 uRlWakeLev[6];         // per level: (centre x, centre y, texel size, valid), local frame (m)
uniform int uRlWakeLevels;
uniform float uRlWakeN;
uniform float uRlLambda;            // Toomre wavelength at the anchor (m)
uniform float uRlHSlab;             // thickness used for the slab bounds (m)
uniform float uRlMarchMax;          // max march distance (m)
uniform int uRlMaxSteps;
// tests (scripts/test/seam.mjs, handover): x = wake representation of the march (0 auto, 1 explicit field only,
// 2 statistics only); y = 1: reference explicit field -- the shared wakeDensity evaluated directly (no clipmap
// prefilter, no prefilter correction) with z stratified sun-path nodes
uniform vec4 uRlForce;
uniform sampler2D uRlExtLut;        // ringLodChannels: 3 bands of RL_LUT_NS rows -- (RP, UP, QP, UFP), (R, U, Q, UF), (QS, QSP)
uniform vec4 uRlExtLutP;            // (c, tMax: column i <-> u = z / H = c sinh(tMax (2 i / (N - 1) - 1)), log10 s0, dlog10 s)
uniform vec4 uRlColTot;             // column totals (z -> -inf) of (QS, QSP, QP) and the column's participation x aligned share
#define RL_LUT_NU 512.0
#define RL_LUT_NS 64.0
#ifdef RL_LOWRES
#define RL_FP_SCALE 2.0     // half-resolution march: prefilter at the 2x2-block footprint
#else
#define RL_FP_SCALE 1.0
#endif
// The explicit wake contrast fades out for footprints of 0.4..0.67 wake spacings (2.5..1.5 px per wake).
// The march -> sheet handover (rlSlabSegment) completes above 2.5 px, so inside the handover zone the
// march always carries the FULL explicit field, statistically equivalent to the sheet's two-column model.
#define RL_WFADE0 0.4
#define RL_WFADE1 0.67
// the march takes the 2-D modulation from the cache around the camera where its footprint and the cache's texels are
// both at most this (m): every texture octave resolved (the finest, 15.6 m, fades above 5.2 m)
#define RL_MC_FP 4.0
#define RL_RELIEF_CACHE 15.0   // horizontal distance (m) between relief evaluations along a march ray

// vertical-structure LUT, band 0 participating / 1 all particles / 2 along the Sun, at height u = z / H, distance s
vec4 rlLut(int band, float u, float s) {
  float xn = clamp(asinh(u / uRlExtLutP.x) / uRlExtLutP.y * 0.5 + 0.5, 0.0, 1.0);
  float ys = clamp((log2(max(s, 1e-3)) * 0.30103 - uRlExtLutP.z) / uRlExtLutP.w, 0.0, RL_LUT_NS - 1.0);
  return texture(uRlExtLut, vec2((xn * (RL_LUT_NU - 1.0) + 0.5) / RL_LUT_NU, (float(band) * RL_LUT_NS + ys + 0.5) / (3.0 * RL_LUT_NS)));
}

// finest valid clipmap level covering xy whose texels are not much finer than the footprint (-1: none)
int rlWakeLevel(vec2 xy, float fp) {
  float halfN = 0.5 * uRlWakeN - 2.0;
  for (int k = 0; k < 6; k++) {
    if (k >= uRlWakeLevels) break;
    vec4 L = uRlWakeLev[k];
    if (L.w < 0.5 || L.z * 1.5 < fp) continue;
    vec2 q = (xy - L.xy) / L.z;
    if (max(abs(q.x), abs(q.y)) < halfN) return k;
  }
  return -1;
}
float rlWakeAt(int k, vec2 xy) {
  vec4 L = uRlWakeLev[k];
  float halfN = 0.5 * uRlWakeN - 2.0;
  vec2 q = clamp((xy - L.xy) / L.z, vec2(-halfN), vec2(halfN));
  vec2 uv = (q + 0.5 * uRlWakeN) / uRlWakeN;
  uv.y = (uv.y + float(k)) / 6.0;
  return texture(uRlWakeTex, uv).r;
}
// W at local position xy for a pixel footprint fp (m); 1 where wakes are unresolved / not cached
float rlWakeW(vec2 xy, float fp) {
  if (uRlWakeLevels <= 0) return 1.0;
  int k = rlWakeLevel(xy, fp);
  if (k < 0) return 1.0;
  return mix(rlWakeAt(k, xy), 1.0, smoothstep(RL_WFADE0 * uRlLambda, RL_WFADE1 * uRlLambda, fp));
}

// Saturnshine beam geometry at camera-relative point p: returns irradiance per face / E_sun (k),
// beam direction cosine muB and the horizontal direction toward Saturn.
float rlSaturnBeams(vec3 p, out float muB, out vec3 hdir, out float thC) {
  vec3 dS;
  float Es = saturnshine(p, dS);
  float dist = length(uSaturnCenter - p);
  float thS = asin(clamp(uSaturnRadii.x / dist, 0.0, 1.0));
  thC = 0.4244 * thS;
  muB = max(sin(thC), 0.02);
  hdir = normalize(vec3(dS.xy, 0.0) + vec3(1e-9, 0.0, 0.0));
  return 0.5 * Es / max(uSunE, 1e-9);
}

// Emission int_0^ts S(t) e^-t dt of a march step of path optical depth ts whose source goes from SA (step
// start) to SB (step end): exponential in t (exact for the attenuation of the sun with depth), linear where
// one end is (nearly) zero.
vec3 rlStepEmit(vec3 SA, vec3 SB, float ts) {
  // linear-model weights of the two ends; series for thin steps (1 - e^-ts rounds to 0 in float32 below ~1e-7,
  // which made the start weight slightly negative)
  float e = exp(-ts);
  float wB = ts > 1e-3 ? (1.0 - (1.0 + ts) * e) / ts : ts * (0.5 - ts / 3.0);
  float wA = ts > 1e-3 ? max(1.0 - e - wB, 0.0) : ts * (0.5 - ts / 6.0);
  vec3 lin = SA * wA + SB * wB;
  // (1 - e^-x) / x with x = ts + ln(SA / SB); boolean mix() selects (no NaN from the branch not taken)
  vec3 x = ts + clamp(log(max(SA, vec3(1e-30)) / max(SB, vec3(1e-30))), -30.0, 30.0);
  bvec3 small = lessThan(abs(x), vec3(1e-3));
  vec3 xs = mix(x, vec3(1.0), small);
  vec3 phi = mix((1.0 - exp(-xs)) / xs, 1.0 - 0.5 * x, small);
  return mix(lin, SA * ts * phi, greaterThan(min(SA, SB), 1e-4 * max(SA, SB)));
}

// The participating particles of a march step thickened by m (packing ceiling): mean column density over the step
// (step-exact through their profile, or the point value for nearly horizontal steps) and the channels at its end.
//   uS, uE: heights of the step's ends (units of H); dzH: their difference (units of H); s, sE: distances
//   bE: the unthickened band-0 channels at uE (reused when m = 1), qS0: the unthickened QP at uS (cached)
// Returns (mean density x the unresolved-share ratio inputs): out pE = (RP, UP, QP, UFP) at uE / m (densities / m),
// the mean participating density over the step (units of the RP channel), and QSP at the end.
float rlStepP(float m, float uS, float uE, float dzH, float s, float sE, vec4 bE, float qS0, float qSP0, out vec4 pE, out float qSP) {
  if (m <= 1.0001) {
    pE = bE;
    qSP = qSP0;
    return abs(dzH) > 0.02 ? abs(qS0 - bE.z) / abs(dzH) : bE.x;
  }
  vec4 b = rlLut(0, uE / m, sE);
  pE = vec4(b.xy / m, b.z, b.w / m);
  qSP = rlLut(2, uE / m, sE).y;
  if (abs(dzH) <= 0.02) return pE.x;
  return abs(rlLut(0, uS / m, s).z - b.z) / abs(dzH);
}

// Multiply-scattered source (per unit optical depth) at a point with the fraction qT of the column above it: the
// two-stream solutions' diffuse fluxes for the Sun (ts) and the Saturnshine beams (tss; kSs per face, muB), emitted
// toward the viewer's side (bv: emergent-direction weight, vSun: viewer on the Sun's side). tts (out): the depth below
// the lit face.
vec3 rlMSSource(RlTS ts, RlTS tss, float qT, float sunSgn, float vis, vec3 alb, float bv, bool vSun, float kSs, float muB, out float tts) {
  float qb = sunSgn > 0.0 ? qT : 1.0 - qT;
  float tauTot = ts.tau;
  tts = qb * tauTot;
  // all beams share the homogeneous solutions exp(-lam (tau - t)), exp(-lam t)
  vec3 ea = exp(-ts.lam * (tauTot - tts));
  vec3 eb = exp(-ts.lam * tts);
  float cS = exp(-tts / ts.mu0);
  vec3 fuS = ts.Ap * ea + ts.B * ts.G * eb + ts.U * cS;
  vec3 fdS = ts.Ap * ts.G * ea + ts.B * eb + ts.V * cS;
  // source for the emergent direction: (1 - beta0) x the flux travelling to the viewer's side + beta0 x the other
  vec3 msS = vSun ? (1.0 - bv) * fuS + bv * fdS : (1.0 - bv) * fdS + bv * fuS;
  vec3 src = vis * alb * max(msS, vec3(0.0));
  if (kSs > 0.0) {
    // Saturnshine multiply-scattered field: beams on the sunlit face (depth tts) and the dark face
    float cL = exp(-tts / muB), cD = exp(-(tauTot - tts) / muB);
    vec3 fuL = tss.Ap * ea + tss.B * tss.G * eb + tss.U * cL;
    vec3 fdL = tss.Ap * tss.G * ea + tss.B * eb + tss.V * cL;
    vec3 fuD = tss.Ap * eb + tss.B * tss.G * ea + tss.U * cD;   // measured from the dark face
    vec3 fdD = tss.Ap * tss.G * eb + tss.B * ea + tss.V * cD;
    vec3 msL = vSun ? (1.0 - bv) * fuL + bv * fdL : (1.0 - bv) * fdL + bv * fuL;
    vec3 msD = vSun ? (1.0 - bv) * fdD + bv * fuD : (1.0 - bv) * fuD + bv * fdD;
    src += kSs * alb * max(msL + msD, vec3(0.0));
  }
  return src * uRlMSScale;
}

float gRlS3 = -1.0;   // diagnostics: distance at which the medium's transmission fell below e^-3
float gRlWsrc = -1.0; // diagnostics: wake source near the midplane (0-5 clipmap level, 6 direct, 7 none)

// March [sA, sB] along camera ray rd. Returns radiance L, transmission T and the number of steps.
void rlMarch(vec3 rd, float sA, float sB, float jitter, out vec3 Lout, out float Tout, out float nSteps) {
  Lout = vec3(0.0);
  Tout = 1.0;
  nSteps = 0.0;
  if (sB <= sA) return;
  vec3 o = uRingCamLocal;
  vec3 d = vec3(dot(rd, uRingER), dot(rd, uRingEPhi), rd.z);
  float dh = max(length(d.xy), 1e-6);
  float az = abs(d.z);
  vec3 V = -rd;
  // relief near the camera: local mid-plane z0 (+ slope g in frame axes) along the ray, from the camera's values
  bool relOn = uRrCamN.w > 0.5 || uRsCam.w > 0.5;
  float z0e = uRsCam.y;
  vec2 g0e = uRrCamN.xy, pe = o.xy;
  vec3 slSun = vec3(dot(uSunDir, uRingER), dot(uSunDir, uRingEPhi), uSunDir.z);   // the Sun in frame axes
  // the local layer at the camera (per ray; updated per step when relOn): normal, the Sun's side and incidence
  vec3 nl = relOn ? normalize(vec3(-g0e, 1.0)) : vec3(0.0, 0.0, 1.0);
  float sunN = dot(slSun, nl);
  // solar incidence on the lit face (the Sun as a disk, as the sheet: ringReliefSunMu)
  float mu0 = max(ringReliefSunMuExt(abs(sunN), uSunAngRadius), 1e-6);
  float cosA = dot(uSunDir, V);
  float vN = dot(-d, nl);
  // viewer on the sunlit side of the layer (light leaving toward the sun face). The multiply-scattered
  // source uses the emergent-direction weights beta0(|V.z|) like the sheet (rlTSEmergeRefl); they tend to
  // 1/2 at the horizontal, so the switch between the two sides is continuous there. The shadow-hiding
  // correlation (sunlit side only) switches over +-1 deg.
  float sunSide = sunN >= 0.0 ? 1.0 : -1.0;
  bool vSun = vN * sunSide > 0.0;
  float towardSun = smoothstep(-0.02, 0.02, vN * sunSide);
  vec2 b0View = texture(uRlPhaseLut, vec2((min(abs(vN), 1.0) * 63.0 + 0.5) / 64.0, 0.5)).rg;
  float bv = b0View.r;
  // direct-sun visibility (Saturn, moons) varies slowly: evaluate at both ends, interpolate
  float sBv = min(sB, sA + 5.0e5);
  vec3 pA = rd * sA, pB = rd * sBv;
  float visA = rlSunVis(pA);
  float visB = rlSunVis(pB);
  // sun path: horizontal offset (local frame) per metre of height toward the sun
  vec3 sl = vec3(dot(uSunDir, uRingER), dot(uSunDir, uRingEPhi), uSunDir.z);
  vec2 sunOff = sl.xy / max(abs(sl.z), 1e-3);
  float sunSgn = sunSide;
  // Saturnshine beams (per ray; relative to the layer at the camera)
  float muB, thC;
  vec3 hdir;
  float kSs = rlSaturnBeams(pA, muB, hdir, thC);
  vec3 nS = relOn ? normalize(vec3(0.0, 0.0, 1.0) - uRrCamN.x * uRingER - uRrCamN.y * uRingEPhi) : vec3(0.0, 0.0, 1.0);
  vec3 bLit = hdir * cos(thC) + nS * (sunSgn * muB);
  vec3 bDark = hdir * cos(thC) - nS * (sunSgn * muB);
  // ray constants: phase functions (macro / dust parts), beam back-scatter fractions, shadow-hiding angle
  float Pm = rlPhase(cosA, 0.0), Pd = rlPhase(cosA, 1.0);
  float PbLm = rlPhase(dot(bLit, V), 0.0), PbLd = rlPhase(dot(bLit, V), 1.0);
  float PbDm = rlPhase(dot(bDark, V), 0.0), PbDd = rlPhase(dot(bDark, V), 1.0);
  vec2 b0Sun = texture(uRlPhaseLut, vec2((mu0 * 63.0 + 0.5) / 64.0, 0.5)).rg;
  vec2 b0Ss = texture(uRlPhaseLut, vec2((clamp(muB, 0.0, 1.0) * 63.0 + 0.5) / 64.0, 0.5)).rg;
  float tanHalfA = tan(min(0.5 * acos(clamp(cosA, -1.0, 1.0)), 1.5));
  float PbL = 0.0, PbD = 0.0;
  // the spin-aligned classes' cross-section along the view and the Sun (sv_ringLod lodAniso; LUT channels UF / QS)
  float Gv = lodAniso(rd), Gs = lodAniso(uSunDir);
  // column totals (z -> -inf): Sun-weighted (non-participating, participating), participating (isotropic)
  float qSPtot = uRlColTot.y, qSNtot = uRlColTot.x - uRlColTot.y, qPtot = max(uRlColTot.z, 1e-6);
  // the column's participation (the stat branch's contrast is that of full participation x the channels' share)
  float pTot = max(uLodTidal.y, 1e-3);

  float s = sA;
  float drCache = 1e30, fpCache = -1.0, tauTS = -1.0, mu0TS = -1.0;
  // relief shadows on the march (cached over 30 m of horizontal travel)
  float relVis = 1.0;
  vec2 pVis = vec2(1e30);
  // streamline-map cache (sv_ringStructure): last evaluation point, its da = a' - r, gradient and J
  float stDr = 1e30, stDth = 0.0, stDa = 0.0, stJ = 1.0;
  vec2 stG = vec2(0.0);
  // propeller cache (their finest structure, the smallest belt propellers' gap lobes, is ~20 m wide): tau factor and
  // the wake-strength factor (no self-gravity wakes in the stirred material), and the latter nearest the mid-plane
  float prDr = 1e30, prDth = 0.0, prFp = -1.0, prM = 1.0, prW = 1.0, prWRef = 1.0, zRefW = 1e30;
  RlS S = rlEmpty();
  float tau = 0.0, tau0 = 0.0, tauTSr = 0.0, P = 0.0, beta = 0.5, bsh = 0.0;
  RlTS tsSun, tsSs;
  float sigPrev = 0.0;
  bool wakesOn = uRlWakeLevels > 0;

  // ---- wake regime of this ray, with the SAME criterion and model as the far-field sheet (rlSlabSegment /
  // rlMainSheet): the explicit field where the wakes span >= 5 px at the slab crossing, the sheet's
  // two-column statistics (dense wakes fB, Wb / gaps Wg, path decorrelation across the crests) where they
  // span <= 2.5 px, blended in between. Within the near-field particle range the march is forced on even
  // for sub-pixel wakes; this keeps it consistent with the sheet there (no aliased ripples, no seam).
  bool statOn = uRlWakeStat.w > 0.0;
  float zcRel = o.z - uRsCam.y;   // camera height above the local mid-plane
  float sRef = clamp(az > 1e-6 ? -zcRel / d.z : sA, sA, sB);
  float fpRef = max(sRef, 0.05) * uPixelAngle * RL_FP_SCALE;
  float wStat = statOn ? (wakesOn ? 1.0 - smoothstep(2.5, 5.0, uRlLambda / fpRef) : 1.0) : 0.0;
  if (uRlForce.x > 0.5) wStat = uRlForce.x > 1.5 && statOn ? 1.0 : 0.0;   // tests: explicit (1) / statistics (2) only
  bool doExp = wStat < 0.999;
  bool doStat = wStat > 0.001;
  float fB = uRlWakeStat.x;
  // stat branch: full-participation column densities (dense wakes b, gaps g): emission, view path, sun path
  float Wb = 1.0, Wg = 1.0, Wvb = 1.0, Wvg = 1.0, Wsb = 1.0, Wsg = 1.0;
  // statistical transmission (as the sheet: Gamma model of the path density, rlTransWakesTau): unresolved optical depth
  // of the column along the ray at W = 1 and its participating part, the path parameters of the last profile sample, and
  // the clipmap level the explicit field was read from nearest the mid-plane (its prefilter correction, see the end)
  float tauV = 0.0, tauVP = 0.0, chiV = 0.0, wsV = 0.0, lamV = uRlLambda, zRef = 1e30, fadeRef = 0.0;
  int kRef = -1;
  // accumulators: explicit field (e), dense-wake column (b), gap column (g)
  float T = 1.0, Tb = 1.0, Tg = 1.0;
  vec3 L = vec3(0.0), Lb = vec3(0.0), Lg = vec3(0.0);
  // Beyond the clipmap's coverage (camera high above the plane: steep, short slab crossings) evaluate the
  // shared wakeDensity directly, once per ray at the midplane crossing (and once along the sun path).
  float Wray = 1.0, WsRay = 1.0, fadeRay = 1.0;
  if (wakesOn && az > 0.05 && zcRel * d.z < 0.0) {
    float sMidR = -zcRel / d.z;
    vec3 lm = o + d * sMidR;
    float fpm = sMidR * uPixelAngle * RL_FP_SCALE;
    fadeRay = smoothstep(RL_WFADE0 * uRlLambda, RL_WFADE1 * uRlLambda, fpm);
    if (fadeRay < 0.85 && rlWakeLevel(lm.xy, fpm) < 0) {
      Wray = wakeDensity(lm.xy);
      WsRay = Wray;
    }
  }
  // column fractions above the current step's start height (< 0: not yet evaluated): all particles, participating
  float Qa = -1.0, QaP = 0.0, QaSP = 0.0;
  float fj = mix(0.3, 0.7, jitter);   // sample point of the profile / wake lookups within a step
  // per accumulator: source at the previous step's end (= this step's start)
  vec3 SeA = vec3(0.0), SbA = vec3(0.0), SgA = vec3(0.0);
  bool haveA = false;
  int steps = 0;
  for (int i = 0; i < 192; i++) {
    float Tact = max(doExp ? T : 0.0, doStat ? max(Tb, Tg) : 0.0);
    if (i >= uRlMaxSteps || s >= sB || Tact < 2e-4) break;
    steps++;
    // ---- step size: resolve the vertical layer, the wake pattern horizontally, the optical depth; grow
    // geometrically far away
    vec3 l0 = o + d * s;
    // height above the local mid-plane at the step start and its rate of change along the ray (relief: the mid-plane
    // extrapolated from the last evaluation with its slope)
    float zr0 = relOn ? l0.z - (z0e + dot(g0e, l0.xy - pe)) : l0.z;
    float azr = relOn ? abs(d.z - dot(g0e, d.xy)) : az;
    float sigZ = 0.2 * S.H;
    float dzW = 0.8 * sigZ + 0.5 * max(abs(zr0) - 2.0 * sigZ, 0.0);
    float dsV = azr > 1e-7 ? dzW / azr : 1e30;
    float fpPix = max(s, 0.05) * uPixelAngle * RL_FP_SCALE;
    float dsH = ((wakesOn && S.wake > 0.02) ? uRlLambda / 6.0 : 30.0) / dh;
    float dsG = 0.07 * s;
    float dsT = 0.8 / max(sigPrev, 1e-7);
    float ds = min(min(dsV, dsT), max(dsH, dsG));
    ds = clamp(ds, 0.02, sB - s);
    float sm = s + ds * fj;
    vec3 l = o + d * sm;
    // ---- profile (cached while the radius changes little); the 2-D modulation evaluated every step
    float dr = ringDrFromLocal(l);
    float dthL = atan(l.y, uRingR0 + l.x);
    float fpR = max(fpPix, ds * abs(d.x) * 0.5);
    // 2-D ring structure (sv_ringStructure): the profile is that of the Lagrangian radius dr + da, tau x J x M.
    // The map is smooth on km scales: re-evaluated when the step moved > 25-100 m radially (less where J varies)
    // or 500 m along the orbit, linearly extrapolated in between.
    float drL = dr;
    float Jst = 1.0;
    if (!rsIdentityAt(dr)) {
      if (abs(dr - stDr) > 25.0 + 75.0 / (1.0 + 4.0 * abs(stJ - 1.0)) || abs(dthL - stDth) * uRingR0 > 500.0) {
        RingStream st = ringStreamMap(dr, dthL, fpR);
        stDr = dr;
        stDth = dthL;
        stDa = st.da;
        stG = st.daGrad;
        stJ = st.J;
      }
      drL = dr + stDa + dot(stG, vec2(dr - stDr, (dthL - stDth) * uRingR0));
      Jst = stJ;
    }
    // ---- relief: the local mid-plane at the sample (forward map at its Lagrangian offset), the layer's normal there,
    // the Sun's side / incidence and the viewer's side relative to it. Re-evaluated every RL_RELIEF_CACHE m of horizontal
    // travel inside the layer (the mid-plane extrapolated linearly with its slope in between: < 0.1 m error for the
    // bending waves and propellers, ~1 m in the Titan wave's 2 km crests), every half of the height above it outside
    // (there it only sizes the steps): the relief's sources cost far more than a step.
    float dCache = max(RL_RELIEF_CACHE, 0.5 * (abs(zr0) - 3.0 * S.H));
    if (relOn && dot(l.xy - pe, l.xy - pe) > dCache * dCache) {
      vec3 rr, zz;
      rsEval(drL, dthL, fpR, true, rr, zz);
      z0e = zz.x;
      g0e = vec2(zz.y * Jst, zz.z);
      pe = l.xy;
      nl = normalize(vec3(-g0e, 1.0));
      sunN = dot(slSun, nl);
      sunSgn = sunN >= 0.0 ? 1.0 : -1.0;
      mu0 = max(ringReliefSunMuExt(abs(sunN), uSunAngRadius), 1e-6);
      vN = dot(-d, nl);
      vSun = vN * sunSgn > 0.0;
      towardSun = smoothstep(-0.02, 0.02, vN * sunSgn);
      b0View = texture(uRlPhaseLut, vec2((min(abs(vN), 1.0) * 63.0 + 0.5) / 64.0, 0.5)).rg;
      b0Sun = texture(uRlPhaseLut, vec2((min(mu0, 1.0) * 63.0 + 0.5) / 64.0, 0.5)).rg;
      zr0 = l0.z - (z0e + dot(g0e, l0.xy - pe));
      // the relief's shadows where there is material to shadow (within 4 H of the local mid-plane)
      if (length(l.xy - pVis) > 30.0 && abs(l.z - z0e) < 4.0 * S.H) {
        relVis = ringReliefSunVis(drL, dthL, z0e, tau0 * Jst, fpR);
        pVis = l.xy;
      }
    }
    float zrE = relOn ? l0.z + d.z * ds - (z0e + dot(g0e, l0.xy + d.xy * ds - pe)) : l0.z + d.z * ds;
    float zrM = relOn ? l.z - (z0e + dot(g0e, l.xy - pe)) : l.z;
    if (abs(drL - drCache) > 50.0 + 0.25 * fpR || fpR > 2.0 * fpCache || fpR < 0.5 * fpCache) {
      S = rlSampleP(uRlIdx0I, uRlIdx0F + drL / uRingDr0, fpR * Jst);
      tau0 = rlTauM(S, 0.918);
      tauTSr = tau0 > 1e-9 ? S.tts / tau0 : 1.0;   // two-stream layer (tau_iso) per unit of the medium's tau
      P = mix(Pm, Pd, S.dust);
      PbL = mix(PbLm, PbLd, S.dust);
      PbD = mix(PbDm, PbDd, S.dust);
      beta = rlBeta(S.dust);
      bv = mix(b0View.r, b0View.g, S.dust);
      bsh = 1.0 / (1.0 + tanHalfA / max(0.375 * S.D * uRlShScale, 1e-5));
      if (statOn) {
        // two-column statistics of the unresolved wakes at FULL participation (the participation is in the LUT's
        // channels): the profile's wake channel is wake x pbar, the probe's field the anchor's (wake x pbar = .w x pTot)
        float wsr = clamp(S.wake / uRlWakeStat.w, 0.0, 2.0) * uRlWakeScale / pTot;
        Wb = max(1.0 + (uRlWakeStat.y - 1.0) * wsr, 0.02);
        Wg = max(1.0 + (uRlWakeStat.z - 1.0) * wsr, 0.02);
        float mW = fB * Wb + (1.0 - fB) * Wg;
        Wb /= mW;
        Wg /= mW;
        float lamL = rlWakeLambda(uRingR0 + dr, S);
        lamV = lamL;
        vec2 hk = towardSun > 0.5 ? uRlWakeHeff.xy : uRlWakeHeff.zw;
        float cv = smoothstep(0.0, 0.5, hk.x * S.H * abs(dot(-d.xy, uRlWakeNrm)) / (max(az, 1e-4) * lamL));
        float cs = smoothstep(0.0, 0.5, hk.y * S.H * abs(dot(sl.xy, uRlWakeNrm)) / (max(abs(sl.z), 1e-3) * lamL));
        Wvb = mix(Wb, 1.0, cv); Wvg = mix(Wg, 1.0, cv);
        Wsb = mix(Wb, 1.0, cs); Wsg = mix(Wg, 1.0, cs);
        chiV = S.H * abs(dot(d.xy, uRlWakeNrm)) / (max(az, 1e-4) * lamL);
        wsV = wsr;
      }
      drCache = drL;
      fpCache = fpR;
      // the layer thickness may have changed: re-evaluate the vertical structure at the step's ends
      Qa = -1.0;
    }
    if (relOn) bv = mix(b0View.r, b0View.g, S.dust);
    {
      // 2-D optical-depth modulation at the step's Lagrangian point (sv_ringStructure hooks): the sub-km texture every
      // step (its finest octave is 16 m radially), the propellers (costly hash-grid enumeration) re-evaluated after 4 m radially / 16 m along the orbit.
      // Only the resolved mean is used: at the march's footprints (< ~1 wake spacing) the texture's unresolved
      // variance is < 5 % of its total (the 16-31 m octaves), a < 0.3 % effect on the mean transmission.
      // Near the camera, where both the step's footprint and the modulation cache's texels are <= RL_MC_FP (every
      // texture octave resolved, the propellers' smallest lobes widened by < 1 %: M at the footprint ~ M at 0), the cache
      // (sv_ringModClip: one or two bilinear lookups) replaces both.
      float fpM = fpR * Jst;
      vec2 mcw;
      float mtp;
      if (fpM <= RL_MC_FP && rsModCachedFine(drL, uRingR0 * dthL, RL_MC_FP, mcw)) {
        mtp = mcw.x;
        prW = mcw.y;
      } else {
        float mt = rsTauModTexture(drL, dthL, fpM).x;
        if (abs(drL - prDr) > 4.0 || abs(dthL - prDth) * uRingR0 > 16.0 || fpM > 2.0 * prFp || fpM < 0.5 * prFp) {
          vec3 pm = rsPropellersMod(drL, dthL, fpM);
          prM = pm.x;
          prW = pm.z;
          prDr = drL;
          prDth = dthL;
          prFp = fpM;
        }
        mtp = mt * prM;
      }
      tau = tau0 * Jst * mtp;
      if (abs(zrM) < zRefW) { zRefW = abs(zrM); prWRef = prW; }   // nearest the local mid-plane (relief)
    }
    // two-stream solutions (the homogeneous tau_iso layer): the multiply-scattered field is smooth -> refresh only on a
    // 15 % tau change (or a 10 % change of the solar incidence on a tilted layer)
    float tauMS = tau * tauTSr;
    if (abs(tauMS - tauTS) > 0.15 * max(tauTS, 0.02) || abs(mu0 - mu0TS) > 0.1 * mu0TS) {
      tsSun = rlTwoStream(tauMS, S.alb, beta, mix(b0Sun.r, b0Sun.g, S.dust), mu0);
      tsSs = rlTwoStream(tauMS, S.alb, beta, mix(b0Ss.r, b0Ss.g, S.dust), muB);
      tauTS = tauMS;
      mu0TS = mu0;
    }
    if (tau <= 0.0) { s += ds; sigPrev = 0.0; Qa = -1.0; haveA = false; continue; }
    float z = zrM;
    float sE = s + ds;
    float uE = zrE / S.H, uS = zr0 / S.H, dzH = uE - uS;
    // ---- vertical structure (LOD contract LUT) at the step end: all particles (bT), participating (bP), along the Sun
    vec4 bT = rlLut(1, uE, sE), bP = rlLut(0, uE, sE), bS = rlLut(2, uE, sE);
    if (Qa < 0.0) { Qa = rlLut(1, uS, s).z; vec4 b0s = rlLut(0, uS, s); QaP = b0s.z; QaSP = rlLut(2, uS, s).y; }
    // the non-participating particles (unthickened): mean density over the step (step-exact through their profile:
    // a point rule underestimates the convex Gaussian tails, all a grazing ray sees of the layer), and at its end the
    // unresolved share along the view / the Sun / isotropic
    vec4 nT = bT - bP;
    float dN = abs(dzH) > 0.02 ? abs((Qa - QaP) - nT.z) / abs(dzH) : nT.x;
    float iN = 1.0 / max(nT.x, 1e-20);
    vec3 rN = vec3(nT.y + Gv * nT.w, nT.y + Gs * nT.w, nT.y) * iN;
    float qsN = bS.x - bS.y;                       // non-participating, Sun-weighted column above the end
    float qN = nT.z;                               // non-participating column above the end (isotropic)
    // the unthickened participating values (m = 1; the thickened ones per wake representation, rlStepP)
    float sunSideN = sunSgn > 0.0 ? qsN : qSNtot - qsN;
    float litN = sunSgn > 0.0 ? qN : (1.0 - qPtot) - qN;
    float sigMax = 0.0;
    float tts = 0.0;
    float fv = clamp((sE - sA) / max(sBv - sA, 1e-3), 0.0, 1.0);
    float vis = mix(visA, visB, fv) * relVis;
    // the participating particles' mean column density over the step at W = 1 (unthickened): the mean layer along the
    // ray for the statistical transmission model (whole-layer paths: the vertical redistribution does not matter)
    float dP1 = abs(dzH) > 0.02 ? abs(QaP - bP.z) / abs(dzH) : bP.x;
    float rP1 = (bP.y + Gv * bP.w) / max(bP.x, 1e-20);
    // single-scattered source per unit (view-path) optical depth for a sun path of slant optical depth sunT, the lit /
    // dark face columns litT / darkT (Saturnshine beams, / muB) and the view-path optical depth tauEv to the step end
    // (shadow hiding: correlation with the sun path near back-scatter; none for light leaving through the unlit face)
    #define RL_SS(sunT, litT, darkT, tauEv) (uRlSSScale * (vis * S.alb * (0.25 * P) * exp(-(sunT)) * exp(bsh * towardSun * min((sunT), (tauEv))) + (kSs > 0.0 ? kSs * S.alb * (0.25 * (PbL * exp(-(litT) / muB) + PbD * exp(-(darkT) / muB))) : vec3(0.0))))
    // ---- explicit wake field (extinction: W at the jittered sample point; source: sun path from the step end)
    if (doExp) {
      float W = 1.0, Ws = 1.0;
      bool ref = uRlForce.y > 0.5;
      int k = wakesOn ? rlWakeLevel(l.xy, ref ? 0.0 : fpPix) : -1;
      float fade = smoothstep(RL_WFADE0 * uRlLambda, RL_WFADE1 * uRlLambda, fpPix);
      if (wakesOn) {
        if (abs(z) < 0.3 * S.H) gRlWsrc = k >= 0 ? float(k) : (Wray != 1.0 ? 6.0 : 7.0);
        if (abs(z) < zRef) { zRef = abs(z); kRef = ref ? -1 : k; fadeRef = fade; }
        if (k >= 0) {
          W = ref ? wakeDensity(l.xy) : mix(rlWakeAt(k, l.xy), 1.0, fade);
        } else {
          W = mix(Wray, 1.0, fadeRay);
        }
        // no self-gravity wakes in a propeller's stirred material (sv_ringStructure wake factor)
        W = mix(1.0, W, prW);
      }
      // the participating particles at this density: thickened by the packing ceiling
      float m = lodPackM(tau, W);
      vec4 pE;
      float qSPe;
      float dP = rlStepP(m, uS, uE, dzH, s, sE, bP, QaP, bS.y, pE, qSPe);
      if (wakesOn) {
        if (k >= 0) {
          vec3 lE = o + d * sE;
          // sun path: mean density at the stratified nodes over the participating column on the Sun's side (sv_ringLod
          // ringSunNodeRise -- the near-field particles and the astronaut use the same nodes; thickened by m)
          float qsP = (sunSgn > 0.0 ? pE.z : qPtot - pE.z) / qPtot;
          float hp = sunSgn * uE / m, acc = 0.0;
          if (uRlForce.y < 0.5) {
            for (int j = 0; j < LOD_SUN_NODES; j++) acc += rlWakeAt(k, lE.xy + sunOff * (m * ringSunNodeRise(j, qsP, hp) * S.H));
            Ws = mix(acc / float(LOD_SUN_NODES), 1.0, fade);
          } else {
            // reference (tests): the shared wakeDensity itself (no clipmap prefilter) at uRlForce.z stratified nodes
            float nN = max(uRlForce.z, 1.0);
            for (int j = 0; j < 32; j++) {
              if (float(j) >= nN) break;
              float hj = ringColumnCentroid(qsP * float(j) / nN, qsP * float(j + 1) / nN);
              acc += wakeDensity(lE.xy + sunOff * (m * max(hj - hp, 0.0) * S.H));
            }
            Ws = acc / nN;
          }
        } else {
          Ws = mix(WsRay, 1.0, fadeRay);
        }
        Ws = mix(1.0, Ws, prW);
      }
      // view extinction (unresolved; spin-aligned classes along the view), emission factors (single scattering: the
      // light intercepted along the Sun; multiple scattering: isotropic)
      float iP = 1.0 / max(pE.x, 1e-20);
      vec3 rP = vec3(pE.y + Gv * pE.w, pE.y + Gs * pE.w, pE.y) * iP;
      vec3 sg = (tau / S.H) * (dN * rN + W * dP * rP);
      float sigU = sg.x;
      sigMax = max(sigMax, (tau / S.H) * (dN + W * dP));
      float ts = sigU * ds;
      if (!doStat) { tauV += (tau / S.H) * (dN * rN.x + dP1 * rP1) * ds; tauVP += (tau / S.H) * dP1 * rP1 * ds; }
      // the Sun's side columns at the end: Sun-weighted (direct sunlight), isotropic (Saturnshine beams)
      float sunSideP = sunSgn > 0.0 ? qSPe : qSPtot - qSPe;
      float litP = sunSgn > 0.0 ? pE.z : qPtot - pE.z;
      float sunT = tau * (sunSideN + Ws * sunSideP) / mu0;
      float litT = tau * (litN + Ws * litP), darkT = tau * ((1.0 - qPtot - litN) + Ws * (qPtot - litP));
      vec3 srcMS = rlMSSource(tsSun, tsSs, qN + pE.z, sunSgn, vis, S.alb, bv, vSun, kSs, muB, tts);
      float iU = sigU > 1e-30 ? 1.0 / sigU : 0.0;
      vec3 SB = RL_SS(sunT, litT, darkT, -log(max(T, 1e-30)) + ts) * (sg.y * iU) + srcMS * (sg.z * iU);
      L += T * rlStepEmit(haveA ? SeA : SB, SB, ts);
      SeA = SB;
      float Tn = T * exp(-ts);
      if (gRlS3 < 0.0 && Tn < 0.0498) gRlS3 = s + ds * log(T / 0.0498) / max(log(T / max(Tn, 1e-30)), 1e-9);
      T = Tn;
    }
    // ---- statistical (unresolved) wakes: two columns, emission ~ W, view attenuation ~ Wv, sun path ~ Ws
    if (doStat) {
      if (abs(z) < 0.3 * S.H && !doExp) gRlWsrc = 8.0;
      // (the two columns' contrast scaled by the propellers' wake factor: the columns' mean stays 1)
      float pWb = mix(1.0, Wb, prW), pWg = mix(1.0, Wg, prW);
      float pWvb = mix(1.0, Wvb, prW), pWvg = mix(1.0, Wvg, prW);
      float pWsb = mix(1.0, Wsb, prW), pWsg = mix(1.0, Wsg, prW);
      // per column: the participating particles thickened by the packing ceiling at the column's density
      vec4 pEb, pEg;
      float qSPb, qSPg;
      float dPb = rlStepP(lodPackM(tau, pWb), uS, uE, dzH, s, sE, bP, QaP, bS.y, pEb, qSPb);
      float dPg = rlStepP(lodPackM(tau, pWg), uS, uE, dzH, s, sE, bP, QaP, bS.y, pEg, qSPg);
      vec3 rPb = vec3(pEb.y + Gv * pEb.w, pEb.y + Gs * pEb.w, pEb.y) / max(pEb.x, 1e-20);
      vec3 rPg = vec3(pEg.y + Gv * pEg.w, pEg.y + Gs * pEg.w, pEg.y) / max(pEg.x, 1e-20);
      // view extinction with the view path's column density (Wv); emission with the column's own (W)
      float sigVb = (tau / S.H) * (dN * rN.x + pWvb * dPb * rPb.x), sigVg = (tau / S.H) * (dN * rN.x + pWvg * dPg * rPg.x);
      vec2 seb = (tau / S.H) * (dN * rN.yz + pWb * dPb * rPb.yz), seg = (tau / S.H) * (dN * rN.yz + pWg * dPg * rPg.yz);
      float tsb = sigVb * ds, tsg = sigVg * ds;
      sigMax = max(sigMax, (tau / S.H) * (dN + max(pWvb * dPb, pWvg * dPg)));
      // the Sun's side columns per column class (direct sunlight Sun-weighted, Saturnshine isotropic)
      float sPb = sunSgn > 0.0 ? qSPb : qSPtot - qSPb, sPg = sunSgn > 0.0 ? qSPg : qSPtot - qSPg;
      float lPb = sunSgn > 0.0 ? pEb.z : qPtot - pEb.z, lPg = sunSgn > 0.0 ? pEg.z : qPtot - pEg.z;
      float dNl = 1.0 - qPtot - litN;
      vec3 srcMS = rlMSSource(tsSun, tsSs, qN + mix(pEg.z, pEb.z, fB), sunSgn, vis, S.alb, bv, vSun, kSs, muB, tts);
      float iUb = sigVb > 1e-30 ? 1.0 / sigVb : 0.0, iUg = sigVg > 1e-30 ? 1.0 / sigVg : 0.0;
      vec3 SBb = RL_SS(tau * (sunSideN + pWsb * sPb) / mu0, tau * (litN + pWsb * lPb), tau * (dNl + pWsb * (qPtot - lPb)), -log(max(Tb, 1e-30)) + tsb) * (seb.x * iUb)
        + srcMS * (seb.y * iUb);
      vec3 SBg = RL_SS(tau * (sunSideN + pWsg * sPg) / mu0, tau * (litN + pWsg * lPg), tau * (dNl + pWsg * (qPtot - lPg)), -log(max(Tg, 1e-30)) + tsg) * (seg.x * iUg)
        + srcMS * (seg.y * iUg);
      Lb += Tb * rlStepEmit(haveA ? SbA : SBb, SBb, tsb);
      Lg += Tg * rlStepEmit(haveA ? SgA : SBg, SBg, tsg);
      SbA = SBb;
      SgA = SBg;
      Tb *= exp(-tsb);
      Tg *= exp(-tsg);
      // the column along the ray at W = 1: the Gamma transmission model's mean optical depth and its participating share
      tauV += (tau / S.H) * (dN * rN.x + dP1 * rP1) * ds;
      tauVP += (tau / S.H) * dP1 * rP1 * ds;
    }
    #undef RL_SS
    Qa = bT.z;
    QaP = bP.z;
    QaSP = bS.y;
    haveA = true;
    sigPrev = sigMax;
    s += ds;
  }
  vec3 Ls = fB * Lb + (1.0 - fB) * Lg;
  // the statistical transmission (Gamma model of the path density) with the contrast of the medium's participation along
  // the ray (the participating share of its optical depth) and the propellers' wake factor nearest the mid-plane
  float pPath = tauV > 0.0 ? tauVP / tauV : pTot;
  float wsP = wsV * prWRef * pPath;
  float mWV = fB * max(1.0 + (uRlWakeStat.y - 1.0) * wsP, 0.02) + (1.0 - fB) * max(1.0 + (uRlWakeStat.z - 1.0) * wsP, 0.02);
  float Ts = doStat ? rlTransWakesTau(tauV, chiV, fB, wsP, mWV) : 1.0;
  // Prefilter correction of the explicit field's transmission: the clipmap texels (box + bilinear, across-crest
  // std 0.5 d) average the density over the pixel footprint BEFORE it is exponentiated, which lowers the mean
  // transmission (convexity; ~5 % near the camera, up to ~40 % at 5 px per wake spacing). The texel smoothing adds
  // to the path's own averaging across the crests (std chi lambda uRlKerSig), so the prefiltered field transmits
  // like the true one at chi_eff = sqrt(chi^2 + (0.5 d / (lambda uRlKerSig))^2), and the contrast fade at large
  // footprints (W -> mix(W, 1, fade)) scales its contrast by 1 - fade: rescaling by the statistical transmission's
  // ratio between the true and the rendered field restores the true mean and keeps the explicit pattern.
  if (doExp && statOn && kRef >= 0 && tauV > 0.0) {
    float chiE = length(vec2(chiV, 0.5 * uRlWakeLev[kRef].z / (max(lamV, 1.0) * max(uRlKerSig, 0.02))));
    float tTrue = rlTransWakesTau(tauV, chiV, fB, wsP, mWV);
    float tPre = rlTransWakesTau(tauV, chiE, fB, wsP * (1.0 - fadeRef), mWV);
    T = min(T * tTrue / max(tPre, 1e-6), 1.0);
  }
  Lout = mix(L, Ls, wStat) * (uSunE * INV_PI);
  Tout = mix(T, Ts, wStat);
  nSteps = float(steps);
}
