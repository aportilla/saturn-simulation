// ===== ring layer: near-field ray march through the particle slab ===============================
// Same radiative transfer as the thin sheet (rlOptics), resolved in 3-D: vertical Gaussian layers per
// size class, self-gravity-wake density W(x, y) (clipmap of the shared wakeDensity), sunlight
// attenuated along its own slanted path through the wakes (wake self-shadowing), the two-stream
// multiply-scattered field at the local depth, Saturnshine on both faces, shadow hiding correlated with
// the view path. Only the optical depth NOT drawn as discrete near-field particles (sigUnres) is carried.
// Analytic per-step integration (source and extinction constant within a step).
//
// The vertical structure comes from a per-frame LUT generated by evaluating the shared sv_ringLod
// functions themselves (ringExtinction, ringLayerTauBeyond) on a (z/H, log s) grid, so it is exactly the
// contract the particle renderer uses, at a fraction of the cost (20 transcendentals -> 1 fetch).
// Requires rlOptics + sv_ringLod + sv_wakes.

uniform sampler2D uRlWakeTex;       // W clipmap atlas (R16F), 6 tiles of N x N stacked vertically
uniform vec4 uRlWakeLev[6];         // per level: (centre x, centre y, texel size, valid), local frame (m)
uniform int uRlWakeLevels;
uniform float uRlWakeN;
uniform float uRlLambda;            // Toomre wavelength at the anchor (m)
uniform float uRlHSlab;             // thickness used for the slab bounds (m)
uniform float uRlMarchMax;          // max march distance (m)
uniform int uRlMaxSteps;
uniform sampler2D uRlExtLut;        // (H sigTot/tau, H sigUnres/tau, column fraction above z, 0)
uniform vec4 uRlExtLutP;            // (u0, du, log10 s0, dlog10 s)
#define RL_LUT_NU 256.0
#define RL_LUT_NS 64.0
#ifdef RL_LOWRES
#define RL_FP_SCALE 2.0     // half-resolution march: prefilter at the 2x2-block footprint
#else
#define RL_FP_SCALE 1.0
#endif
// The explicit wake contrast fades out for footprints of 0.4..0.67 wake spacings (2.5..1.5 px per wake).
// The march -> sheet handover (rlSlabSegment) completes above 2.5 px, so inside the handover zone the
// march always carries the FULL explicit field, statistically equivalent to the sheet's two-column model.
#define RL_WFADE0 0.4
#define RL_WFADE1 0.67

vec3 rlExt(float z, float H, float s) {
  float x = ((z / H - uRlExtLutP.x) / uRlExtLutP.y + 0.5) / RL_LUT_NU;
  float y = ((log2(max(s, 1e-3)) * 0.30103 - uRlExtLutP.z) / uRlExtLutP.w + 0.5) / RL_LUT_NS;
  return texture(uRlExtLut, vec2(x, y)).rgb;
}

// finest valid clipmap level covering xy whose texels are not much finer than the footprint (-1: none)
int rlWakeLevel(vec2 xy, float fp) {
  float halfN = 0.5 * uRlWakeN - 2.0;
  for (int k = 0; k < 6; k++) {
    if (k >= uRlWakeLevels) break;
    vec4 L = uRlWakeLev[k];
    if (L.w < 0.5 || L.z * 1.5 < fp) continue;
    vec2 q = (xy - L.xy) / L.z;
    if (max(abs(q.x), abs(q.y)) < halfN) return k;
  }
  return -1;
}
float rlWakeAt(int k, vec2 xy) {
  vec4 L = uRlWakeLev[k];
  float halfN = 0.5 * uRlWakeN - 2.0;
  vec2 q = clamp((xy - L.xy) / L.z, vec2(-halfN), vec2(halfN));
  vec2 uv = (q + 0.5 * uRlWakeN) / uRlWakeN;
  uv.y = (uv.y + float(k)) / 6.0;
  return texture(uRlWakeTex, uv).r;
}
// W at local position xy for a pixel footprint fp (m); 1 where wakes are unresolved / not cached
float rlWakeW(vec2 xy, float fp) {
  if (uRlWakeLevels <= 0) return 1.0;
  int k = rlWakeLevel(xy, fp);
  if (k < 0) return 1.0;
  return mix(rlWakeAt(k, xy), 1.0, smoothstep(RL_WFADE0 * uRlLambda, RL_WFADE1 * uRlLambda, fp));
}

// Saturnshine beam geometry at camera-relative point p: returns irradiance per face / E_sun (k),
// beam direction cosine muB and the horizontal direction toward Saturn.
float rlSaturnBeams(vec3 p, out float muB, out vec3 hdir, out float thC) {
  vec3 dS;
  float Es = saturnshine(p, dS);
  float dist = length(uSaturnCenter - p);
  float thS = asin(clamp(uSaturnRadii.x / dist, 0.0, 1.0));
  thC = 0.4244 * thS;
  muB = max(sin(thC), 0.02);
  hdir = normalize(vec3(dS.xy, 0.0) + vec3(1e-9, 0.0, 0.0));
  return 0.5 * Es / max(uSunE, 1e-9);
}

float gRlS3 = -1.0;   // diagnostics: distance at which the medium's transmission fell below e^-3
float gRlWsrc = -1.0; // diagnostics: wake source near the midplane (0-5 clipmap level, 6 direct, 7 none)

// March [sA, sB] along camera ray rd. Returns radiance L, transmission T and the number of steps.
void rlMarch(vec3 rd, float sA, float sB, float jitter, out vec3 Lout, out float Tout, out float nSteps) {
  Lout = vec3(0.0);
  Tout = 1.0;
  nSteps = 0.0;
  if (sB <= sA) return;
  vec3 o = uRingCamLocal;
  vec3 d = vec3(dot(rd, uRingER), dot(rd, uRingEPhi), rd.z);
  float dh = max(length(d.xy), 1e-6);
  float az = abs(d.z);
  vec3 V = -rd;
  float mu0 = max(uRlMu0, 1e-3);
  float cosA = dot(uSunDir, V);
  float towardSun = smoothstep(-0.12, 0.12, V.z * uRlSunSign);
  // direct-sun visibility (Saturn, moons) varies slowly: evaluate at both ends, interpolate
  float sBv = min(sB, sA + 5.0e5);
  vec3 pA = rd * sA, pB = rd * sBv;
  float visA = rlSunVis(pA);
  float visB = rlSunVis(pB);
  // sun path: horizontal offset (local frame) per metre of height toward the sun
  vec3 sl = vec3(dot(uSunDir, uRingER), dot(uSunDir, uRingEPhi), uSunDir.z);
  vec2 sunOff = sl.xy / max(abs(sl.z), 1e-3);
  float sunSgn = uRlSunSign;
  // Saturnshine beams (per ray)
  float muB, thC;
  vec3 hdir;
  float kSs = rlSaturnBeams(pA, muB, hdir, thC);
  vec3 bLit = hdir * cos(thC) + vec3(0.0, 0.0, sunSgn * muB);
  vec3 bDark = hdir * cos(thC) - vec3(0.0, 0.0, sunSgn * muB);
  // ray constants: phase functions (macro / dust parts), beam back-scatter fractions, shadow-hiding angle
  float Pm = rlPhase(cosA, 0.0), Pd = rlPhase(cosA, 1.0);
  float PbLm = rlPhase(dot(bLit, V), 0.0), PbLd = rlPhase(dot(bLit, V), 1.0);
  float PbDm = rlPhase(dot(bDark, V), 0.0), PbDd = rlPhase(dot(bDark, V), 1.0);
  vec2 b0Sun = texture(uRlPhaseLut, vec2((mu0 * 63.0 + 0.5) / 64.0, 0.5)).rg;
  vec2 b0Ss = texture(uRlPhaseLut, vec2((clamp(muB, 0.0, 1.0) * 63.0 + 0.5) / 64.0, 0.5)).rg;
  float tanHalfA = tan(min(0.5 * acos(clamp(cosA, -1.0, 1.0)), 1.5));
  float PbL = 0.0, PbD = 0.0;

  float s = sA;
  float T = 1.0;
  vec3 L = vec3(0.0);
  float drCache = 1e30, fpCache = -1.0, tauTS = -1.0;
  RlS S = rlEmpty();
  float tau = 0.0, tau0 = 0.0, P = 0.0, beta = 0.5, bsh = 0.0;
  RlTS tsSun, tsSs;
  float sigPrev = 0.0;
  bool wakesOn = uRlWakeLevels > 0;
  // Beyond the clipmap's coverage (camera high above the plane: steep, short slab crossings) evaluate the
  // shared wakeDensity directly, once per ray at the midplane crossing (and once along the sun path).
  float Wray = 1.0, WsRay = 1.0, fadeRay = 1.0;
  if (wakesOn && az > 0.05 && o.z * d.z < 0.0) {
    float sMidR = -o.z / d.z;
    vec3 lm = o + d * sMidR;
    float fpm = sMidR * uPixelAngle * RL_FP_SCALE;
    fadeRay = smoothstep(RL_WFADE0 * uRlLambda, RL_WFADE1 * uRlLambda, fpm);
    if (fadeRay < 0.85 && rlWakeLevel(lm.xy, fpm) < 0) {
      Wray = wakeDensity(lm.xy);
      WsRay = Wray;
    }
  }
  int steps = 0;
  for (int i = 0; i < 192; i++) {
    if (i >= uRlMaxSteps || s >= sB || T < 2e-4) break;
    steps++;
    // ---- step size: resolve the vertical layer (midpoint rule on a Gaussian is very accurate at
    // ~sigma steps), the wake pattern horizontally, the optical depth; grow geometrically far away
    vec3 l0 = o + d * s;
    float sigZ = 0.2 * S.H;
    float dzW = 0.8 * sigZ + 0.5 * max(abs(l0.z) - 2.0 * sigZ, 0.0);
    float dsV = az > 1e-7 ? dzW / az : 1e30;
    float fpPix = max(s, 0.05) * uPixelAngle * RL_FP_SCALE;
    float dsH = ((wakesOn && S.wake > 0.02) ? uRlLambda / 6.0 : 30.0) / dh;
    float dsG = 0.07 * s;
    float dsT = 0.8 / max(sigPrev, 1e-7);
    float ds = min(min(dsV, dsT), max(dsH, dsG));
    ds = clamp(ds, 0.02, sB - s);
    float sm = s + ds * mix(0.3, 0.7, jitter);
    vec3 l = o + d * sm;
    // ---- profile (cached while the radius changes little); sub-km structure evaluated every step
    float dr = ringDrFromLocal(l);
    float fpR = max(fpPix, ds * abs(d.x) * 0.5);
    if (abs(dr - drCache) > 50.0 + 0.25 * fpR || fpR > 2.0 * fpCache || fpR < 0.5 * fpCache) {
      S = rlSample(uRingIdx0 + dr / uRingDr0, fpR);
      tau0 = rlTauM(S, 0.918);
      P = mix(Pm, Pd, S.dust);
      PbL = mix(PbLm, PbLd, S.dust);
      PbD = mix(PbDm, PbDd, S.dust);
      beta = rlBeta(S.dust);
      bsh = 1.0 / (1.0 + tanHalfA / max(0.375 * S.D * uRlShScale, 1e-5));
      drCache = dr;
      fpCache = fpR;
    }
    {
      float xF = uRlIdx0F + dr / uRingDr0;
      float kF = floor(xF);
      tau = tau0 * rlFineFactor(uRlIdx0I + kF, xF - kF, fpR, tau0, S.wake);
    }
    // two-stream solutions: the multiply-scattered field is smooth -> refresh only on a 15 % tau change
    if (abs(tau - tauTS) > 0.15 * max(tauTS, 0.02)) {
      tsSun = rlTwoStream(tau, S.alb, beta, mix(b0Sun.r, b0Sun.g, S.dust), mu0);
      tsSs = rlTwoStream(tau, S.alb, beta, mix(b0Ss.r, b0Ss.g, S.dust), muB);
      tauTS = tau;
    }
    if (tau <= 0.0) { s += ds; sigPrev = 0.0; continue; }
    // ---- local density: wakes at the sample and along the sun path
    float z = l.z;
    float W = 1.0, Ws = 1.0;
    if (wakesOn) {
      int k = rlWakeLevel(l.xy, fpPix);
      if (abs(z) < 0.3 * S.H) gRlWsrc = k >= 0 ? float(k) : (Wray != 1.0 ? 6.0 : 7.0);
      if (k >= 0) {
        float fade = smoothstep(RL_WFADE0 * uRlLambda, RL_WFADE1 * uRlLambda, fpPix);
        float sz = 0.22 * S.H;
        // the sunward column is concentrated within ~1-2 sigma of the midplane (or just beyond z)
        float h1 = max(sz * 0.6, -sunSgn * z + 0.3 * sz);
        float h2 = max(sz * 1.8, -sunSgn * z + 1.2 * sz);
        W = mix(rlWakeAt(k, l.xy), 1.0, fade);
        Ws = mix(0.5 * (rlWakeAt(k, l.xy + sunOff * h1) + rlWakeAt(k, l.xy + sunOff * h2)), 1.0, fade);
      } else {
        W = mix(Wray, 1.0, fadeRay);
        Ws = mix(WsRay, 1.0, fadeRay);
      }
    }
    vec3 ex = rlExt(z, S.H, sm);
    float sigT = tau * W * ex.x / S.H;
    float sigU = tau * W * ex.y / S.H;
    sigPrev = sigT;
    float qb = sunSgn > 0.0 ? ex.z : 1.0 - ex.z;   // column fraction on the sunlit side of z
    float tSun = qb * tau * Ws / mu0;
    float tauTot = tsSun.tau;                      // depth coordinate of the cached two-stream solution
    float tts = qb * tauTot;
    // shadow hiding: the view-path optical depth at the SAMPLE point (step midpoint, like tSun), so that at
    // exact back-scatter (tSun = tauE) the correlation cancels the sun attenuation exactly, as in the sheet
    // formula. No correlation for light leaving through the unlit face (transmission geometry).
    float tauE = -log(max(T, 1e-30)) + sigU * (sm - s);
    float sh = exp(bsh * towardSun * min(tSun, tauE));
    float fv = clamp((sm - sA) / max(sBv - sA, 1e-3), 0.0, 1.0);
    float vis = mix(visA, visB, fv);
    // diffuse fluxes: all beams share the homogeneous solutions exp(-lam (tau - t)), exp(-lam t)
    vec3 ea = exp(-tsSun.lam * (tauTot - tts));
    vec3 eb = exp(-tsSun.lam * tts);
    float cS = exp(-tts / tsSun.mu0);
    vec3 fuS = tsSun.Ap * ea + tsSun.B * tsSun.G * eb + tsSun.U * cS;
    vec3 fdS = tsSun.Ap * tsSun.G * ea + tsSun.B * eb + tsSun.V * cS;
    vec3 msS = mix((1.0 - beta) * fdS + beta * fuS, (1.0 - beta) * fuS + beta * fdS, towardSun);
    vec3 src = vis * S.alb * (0.25 * P * exp(-tSun) * sh + max(msS, vec3(0.0)));
    if (kSs > 0.0) {
      // Saturnshine on the sunlit face (depth tts) and on the dark face (depth tau - tts)
      float cL = exp(-tts / muB), cD = exp(-(tauTot - tts) / muB);
      vec3 fuL = tsSs.Ap * ea + tsSs.B * tsSs.G * eb + tsSs.U * cL;
      vec3 fdL = tsSs.Ap * tsSs.G * ea + tsSs.B * eb + tsSs.V * cL;
      vec3 fuD = tsSs.Ap * eb + tsSs.B * tsSs.G * ea + tsSs.U * cD;   // measured from the dark face
      vec3 fdD = tsSs.Ap * tsSs.G * eb + tsSs.B * ea + tsSs.V * cD;
      vec3 msL = mix((1.0 - beta) * fdL + beta * fuL, (1.0 - beta) * fuL + beta * fdL, towardSun);
      vec3 msD = mix((1.0 - beta) * fuD + beta * fdD, (1.0 - beta) * fdD + beta * fuD, towardSun);
      float cl = qb * tau * W / muB, cd = (1.0 - qb) * tau * W / muB;
      src += kSs * S.alb * (0.25 * (PbL * exp(-cl) + PbD * exp(-cd)) + max(msL + msD, vec3(0.0)));
    }
    float a = 1.0 - exp(-sigU * ds);
    L += T * src * a;
    float Tn = T * (1.0 - a);
    if (gRlS3 < 0.0 && Tn < 0.0498) gRlS3 = s + ds * log(T / 0.0498) / max(log(T / max(Tn, 1e-30)), 1e-9);
    T = Tn;
    s += ds;
  }
  Lout = L * (uSunE * INV_PI);
  Tout = T;
  nSteps = float(steps);
}
